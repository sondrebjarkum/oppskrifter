---
import Modal from "./shared/Modal/Modal.astro";
---

<div class="tooltip" data-tip="Ny oppskrift">
  <button
    class="btn btn-square btn-ghost"
    onclick="create_recipe_modal.showModal()"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.5"
      stroke="currentColor"
      class="size-6"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m3.75 9v6m3-3H9m1.5-12H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"
      ></path>
    </svg>
  </button>
</div>
<Modal id="create_recipe_modal" title="Ny oppskrift">
  <form id="create-recipe-form" class="w-full">
    <fieldset class="fieldset">
      <legend class="fieldset-legend"
        >Lag en ny oppskrift <span class="text-accent">(*påkrevd)</span></legend
      >
      <label class="label">Navn *</label>
      <input
        name="title"
        type="text"
        class="input w-full"
        placeholder="Navn på oppskriften"
        required
      />

      <label class="label">Kategori *</label>
      <input
        name="category"
        type="text"
        class="input w-full"
        placeholder="Feks. middag"
        required
      />

      <label class="label">Underkategori</label>
      <input
        name="subcategory"
        type="text"
        class="input w-full"
        placeholder="Feks. supper"
      />

      <label class="label">Kilde</label>
      <input
        name="source"
        type="text"
        class="input w-full"
        placeholder="Kilde til oppskriften"
      />

      <div class="mt-4">
        <p>Du kan skrive selve oppskriften etter den er opprettet.</p>
        <p>Opprettelse av oppskrift tar cirka ett minutt.</p>
      </div>

      <button type="submit" class="btn btn-neutral mt-4">Opprett</button>
    </fieldset>
  </form>
</Modal>

<script>
  import { supabase } from "../integrations/supabase/supabase-client";

  const form = document.querySelector<HTMLFormElement>("#create-recipe-form");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const {
      data: { session },
    } = await supabase.auth.getSession();
    if (!session) {
      alert("Du må logge inn først");
      return;
    }

    const submitButton = form.querySelector<HTMLButtonElement>("button[type=submit]");
    if (submitButton) submitButton.disabled = true;

    const formData = new FormData(form);
    const body = Object.fromEntries(formData.entries());

    // supabase-js automatically sends the user's JWT
    const { data, error } = await supabase.functions.invoke("create-recipe", {
      body,
    });

    if (submitButton) submitButton.disabled = false;

    if (error) {
      alert(`Kunne ikke opprette oppskrift: ${error.message}`);
      return;
    }

    form.reset();
    (document.getElementById("create_recipe_modal") as HTMLDialogElement)?.close();
    alert(`Opprettet ${data.id}! Commit ${data.commit.slice(0, 7)}`);
  });
</script>
