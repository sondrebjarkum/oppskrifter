<label class="input w-full sm:w-xs">
  <svg
    class="h-[1em] opacity-50"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
  >
    <g
      stroke-linejoin="round"
      stroke-linecap="round"
      stroke-width="2.5"
      fill="none"
      stroke="currentColor"
    >
      <circle cx="11" cy="11" r="8"></circle>
      <path d="m21 21-4.3-4.3"></path>
    </g>
  </svg>
  <input
    type="search"
    placeholder="Search"
    autocomplete="off"
    id="recipe-search"
  />
  <kbd class="kbd kbd-sm opacity-50 hidden sm:inline-block">⌘ K</kbd>
</label>

<script>
  const input = document.getElementById("recipe-search") as HTMLInputElement;
  const sections = document.querySelectorAll<HTMLElement>(
    "section[data-category]",
  );

  const filter = () => {
    const query = input.value.trim().toLocaleLowerCase("nb");

    sections.forEach((section) => {
      let sectionVisible = false;
      section.querySelectorAll<HTMLElement>("li[data-title]").forEach((li) => {
        const match = li.dataset.title!.includes(query);
        li.hidden = !match;
        if (match) sectionVisible = true;
      });
      section.hidden = !sectionVisible;
    });
  };

  input.addEventListener("input", filter);

  document.addEventListener("keydown", (e) => {
    if (e.metaKey && e.key.toLowerCase() === "k") {
      e.preventDefault();
      input.focus();
      input.select();
    }
  });
</script>
