<div class="indicator">
  <a
    href="/settings"
    class="btn btn-circle btn-ghost btn-md lg:btn-sm opacity-50 data-logged-in:opacity-100 peer"
    id="avatar-link"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.5"
      stroke="currentColor"
      class="size-6"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"
      ></path>
    </svg>
  </a>
  <span class="indicator-item status status-neutral peer-data-logged-in:status-success"></span>
</div>

<script is:inline>
  const isLoggedIn = localStorage.getItem("email");

  if (isLoggedIn) {
    const avatar = document.getElementById("avatar-link");
    if (avatar) {
      avatar.setAttribute("data-logged-in", "")
    }
  }
</script>

