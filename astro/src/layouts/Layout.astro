---
import Auth from "../components/Auth.astro";
import Avatar from "../components/Avatar.astro";
import ShoppingListLink from "../components/ShoppingListLink.astro";
import ThemePicker from "../components/ThemePicker.astro";
import "../styles/global.css";
const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="no">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="any" />
    <title>{title ? `${title} | ` : ""} Oppskrifter</title>

    <Auth />

    <script is:inline>
      const theme = localStorage.getItem("theme");
      if (theme && theme !== "default") {
        document.documentElement.setAttribute("data-theme", theme);
      }
    </script>
  </head>

  <body>
    <div
      class="navbar bg-base-100 shadow-sm mb-12 justify-center pl-0 pr-0 print:hidden"
    >
      <nav class="flex justify-between w-full max-w-2xl ml-6 mr-6">
        <div class="breadcrumbs text-base lg:text-sm">
          <ul>
            <li>
              <a href={`${base}/`}>
                <img src={`${base}/favicon.svg`} alt="" class="w-5 h-5" />
                Home</a
              >
            </li>
          </ul>
        </div>

        <div class="flex gap-2">
          <ThemePicker />
          <ShoppingListLink />
          <Avatar />
        </div>
      </nav>
    </div>
    <main class="ml-6 mr-6 pb-12">
      <div class="max-w-2xl mx-auto">
        <slot />
      </div>
    </main>
  </body>
</html>
