---
const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!DOCTYPE html>
<html lang="no">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <nav><a href={`${base}/`}>Oppskrifter</a></nav>
    <main><slot /></main>
  </body>
</html>

<style is:global>
  body { font-family: Georgia, serif; max-width: 700px; margin: 0 auto; padding: 1rem; line-height: 1.6; }
</style>