---
import ThemePicker from "../components/ThemePicker.astro";
import "../styles/global.css";
const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="no">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="any" />
    <title>{title}</title>

    <script is:inline>
      const theme = localStorage.getItem("theme");
      if (theme && theme !== "default") {
        document.documentElement.setAttribute("data-theme", theme);
      }
    </script>
  </head>
  <body>
    <div class="navbar bg-base-100 shadow-sm mb-12 justify-center pl-0 pr-0">
      <nav class="flex justify-between w-full max-w-2xl ml-6 mr-6">
        <div class="breadcrumbs text-sm">
          <ul>
            <li><a href={`${base}/`}>Home</a></li>
          </ul>
        </div>
        <ThemePicker />
      </nav>
    </div>
    <main class="ml-6 mr-6 pb-12">
      <slot />
    </main>
  </body>
</html>
