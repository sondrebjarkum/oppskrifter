---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const compare = (a, b) => a.localeCompare(b, "nb", { sensitivity: "base" });
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const recipes = (await getCollection("recipes")).map((r) => ({
  id: r.id,
  category: r.data.category,
  title: r.body?.match(/^#\s+(.+)$/m)?.[1].trim() ?? r.id,
}));

const grouped = Object.groupBy(recipes, (r) => r.category);
const categories = Object.keys(grouped).sort(compare);
---

<Layout title="Oppskrifter">
  <div class="prose mx-auto">
    <h1>Oppskrifter</h1>
    {
      categories.map((category) => (
        <section>
          <h2>{category.charAt(0).toUpperCase() + category.slice(1)}</h2>
          <ul>
            {grouped[category]
              .sort((a, b) => compare(a.title, b.title))
              .map((r) => (
                <li>
                  <a href={`${base}/recipes/${r.id}/`}>{r.title}</a>
                </li>
              ))}
          </ul>
        </section>
      ))
    }
  </div>
</Layout>
