---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import RecipeSearch from "../components/RecipeSearch.astro";
import Toolbar from "../components/Toolbar.astro";
import Print from "../components/Print.astro";
import RecipeFilters from "../components/RecipeFilters.astro";

const compare = (a: string, b: string) =>
  a.localeCompare(b, "nb", { sensitivity: "base" });
const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const recipes = (await getCollection("recipes")).map((r) => ({
  id: r.id,
  category: r.data.category,
  subcategory: r.data.subcategory ?? "",
  // title: r.body?.match(/^#\s+(.+)$/m)?.[1].trim() ?? r.id,
  title: r.data.title,
}));

const byTitle = (a, b) => compare(a.title, b.title);

const grouped = Object.entries(Object.groupBy(recipes, (r) => r.category))
  .sort(([a], [b]) => compare(a, b))
  .map(([category, items]) => {
    const subs = Object.entries(Object.groupBy(items, (r) => r.subcategory))
      .sort(([a], [b]) => (a === "" ? -1 : b === "" ? 1 : compare(a, b)))
      .map(([subcategory, list]) => ({
        subcategory,
        recipes: list.sort(byTitle),
      }));
    return { category, subs };
  });
---

<Layout title="Oppskrifter">
  <Toolbar>
    <RecipeSearch />
    <div class="flex">
      <RecipeFilters />
      <Print />
    </div>
  </Toolbar>
  <div class="prose lg:prose-lg max-w-none mx-auto">
    <h1 class="sr-only">Oppskrifter</h1>
    {
      grouped.map(({ category, subs }) => (
        <section data-category>
          <h2>{capitalize(category)}</h2>
          {subs.map(({ subcategory, recipes }) => (
            <div data-subcategory>
              {subcategory && (
                <h3 class="text-xl! ml-2">{capitalize(subcategory)}</h3>
              )}
              <ul>
                {recipes.map((r) => (
                  <li
                    data-title={r.title.toLocaleLowerCase("nb")}
                    data-favorite={
                      r.title.includes("⭐") ? "true" : "false"
                    }
                    class={subcategory ? "ml-2" : ""}
                  >
                    <a href={`${base}/recipes/${r.id}/`}>{r.title}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      ))
    }
  </div>
</Layout>
